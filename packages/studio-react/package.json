{
  "name": "@vibress/studio-react",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && node ../../scripts/build-package-esm.mjs && mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lexical/code": "0.14.3",
    "@lexical/history": "0.14.3",
    "@lexical/html": "0.14.3",
    "@lexical/link": "0.14.3",
    "@lexical/list": "0.14.3",
    "@lexical/markdown": "0.14.3",
    "@lexical/react": "0.14.3",
    "@lexical/rich-text": "0.14.3",
    "@lexical/selection": "0.14.3",
    "@lexical/table": "0.14.3",
    "@lexical/utils": "0.14.3",
    "@vibress/studio-cards": "workspace:*",
    "@vibress/studio-core": "workspace:*",
    "@vibress/studio-html": "workspace:*",
    "@vibress/studio-markdown": "workspace:*",
    "@vibress/studio-nodes": "workspace:*",
    "@vibress/studio-plugin-sdk": "workspace:*",
    "@vibress/studio-renderer": "workspace:*",
    "@vibress/studio-serializer": "workspace:*",
    "@vibress/studio-transforms": "workspace:*",
    "@vibress/studio-utils": "workspace:*",
    "lexical": "0.14.3",
    "lucide-react": "^1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7"
  },
  "nx": {
    "tags": [
      "type:platform"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/studio.css",
    "./tokens.css": "./dist/styles/tokens.css"
  },
  "files": [
    "dist"
  ]
}

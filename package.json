{
  "name": "vibress-studio-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:explicit-any": "node scripts/count-explicit-any.mjs --max 50",
    "verify:package-exports": "node scripts/verify-package-exports.mjs",
    "verify:consumer-imports": "node scripts/verify-consumer-imports.mjs",
    "verify:packed-consumer": "node scripts/verify-packed-consumer.mjs",
    "verify:host-compatibility": "node scripts/verify-host-compatibility.mjs",
    "benchmark:document": "node scripts/benchmark-document-pipeline.mjs",
    "benchmark:editor": "playwright test --config e2e/performance.config.ts",
    "benchmark:compare": "node scripts/compare-editor-benchmarks.mjs",
    "test:security": "vitest run packages/studio-testing/security",
    "test:a11y": "vitest run packages/studio-testing/a11y",
    "test:roundtrip": "vitest run packages/studio-testing/security/roundtrip.test.ts packages/studio-testing/roundtrip",
    "repo:health": "node scripts/count-explicit-any.mjs --max 50",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:lighthouse": "playwright test --config e2e/playwright.config.ts specs/08-lighthouse.spec.ts",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "^4.13.0",
    "chrome-launcher": "^1.2.1",
    "esbuild": "0.21.5",
    "eslint": "^10.8.0",
    "jsdom": "^24.1.0",
    "lighthouse": "^13.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.66.0",
    "vitepress": "1.6.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.17.0"
  }
}
